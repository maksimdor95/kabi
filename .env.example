# --- Telegram ---
TELEGRAM_BOT_TOKEN=       # от @BotFather

# --- LLM (Yandex AI Studio, OpenAI-compatible) ---
LLM_API_KEY=              # yc iam api-key (scope: yc.ai.languageModels.execute)
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_FOLDER_ID=            # id каталога Yandex Cloud
LLM_MODEL_PRIMARY=gpt://<folder-id>/yandexgpt/latest              # мощная модель
LLM_MODEL_CHEAP=gpt://<folder-id>/yandexgpt-lite/latest           # дешёвая модель
LLM_MODEL_EMBED_DOC=emb://<folder-id>/text-search-doc/latest      # эмбеддинги возможностей (dim=256)
LLM_MODEL_EMBED_QUERY=emb://<folder-id>/text-search-query/latest  # эмбеддинги профиля (dim=256)

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kabi
POSTGRES_USER=kabi
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Job boards ---
HH_API_URL=https://api.hh.ru
HH_API_KEY=            # APPL-токен приложения с dev.hh.ru (поиск вакансий)
HH_USER_AGENT=KabiCareerManager/0.1 (you@example.com)
SUPERJOB_API_URL=https://api.superjob.ru/2.0
SUPERJOB_API_KEY=      # X-Api-App-Id (v3....) с api.superjob.ru
SUPERJOB_TOWN=4        # Москва в справочнике SuperJob

# --- LinkedIn enrichment (обход login-wall; нарушает ToS; только свой профиль) ---
# Скопируй cookie li_at из браузера (DevTools → Application → Cookies → linkedin.com)
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=      # опционально, если без него wall остаётся

# --- App ---
APP_ENV=local            # local | prod
LOG_LEVEL=INFO
